---
/**
 * Small inline social/contact icons.
 * Using inline SVGs rather than an icon library because Lucide has dropped
 * brand icons (LinkedIn, GitHub) for trademark reasons, so we need SVGs for
 * those anyway. Sticking to one approach keeps the bundle tiny.
 *
 * Props:
 *   - name : which icon to render
 *   - size : pixel size (width == height); defaults to 22
 */

type IconName = "mail" | "facebook" | "linkedin" | "github" | "itchio";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 22, class: className } = Astro.props;
---

{name === "mail" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
  >
    <rect width="20" height="16" x="2" y="4" rx="2" />
    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
  </svg>
)}

{name === "facebook" && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class={className}
  >
    <path d="M24 12.073C24 5.446 18.627.073 12 .073S0 5.446 0 12.073c0 5.99 4.388 10.955 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.028 24 18.062 24 12.073z"/>
  </svg>
)}

