---
import { profile } from "~/data/profile";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[color:var(--color-border)]">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-6 py-8 sm:flex-row sm:items-center">
    <p class="text-sm text-[color:var(--color-fg-subtle)]">
      &copy; {year} {profile.name}. All rights reserved.
    </p>
    <p class="text-xs text-[color:var(--color-fg-subtle)]">
      Built with Astro &middot; hosted on Hostinger
    </p>
  </div>
</footer>
