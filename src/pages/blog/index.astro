---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Blog — Hai Dang"
  description="Technical write-ups on Unity mobile game development."
  path="/blog"
>
  <section class="mx-auto max-w-6xl px-6 py-24 sm:py-28">
    <header class="mb-12">
      <p class="font-[family-name:var(--font-display)] text-sm uppercase tracking-[0.2em] text-[color:var(--color-fg-subtle)]">
        Writing
      </p>
      <h1 class="mt-2 font-[family-name:var(--font-display)] text-4xl font-semibold tracking-tight text-[color:var(--color-fg)] sm:text-5xl">
        Blog
      </h1>
      <p class="mt-3 max-w-xl text-[color:var(--color-fg-muted)]">
        Fun stuffs I found.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="divide-y divide-[color:var(--color-border)] border-t border-[color:var(--color-border)]">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col gap-2 py-6 transition-colors sm:flex-row sm:items-baseline sm:justify-between"
              >
                <div>
                  <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold text-[color:var(--color-fg)] transition-colors group-hover:text-[color:var(--color-accent)]">
                    {post.data.title}
                  </h2>
                  <p class="mt-1 max-w-2xl text-sm text-[color:var(--color-fg-muted)]">
                    {post.data.description}
                  </p>
                </div>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="shrink-0 text-sm text-[color:var(--color-fg-subtle)] sm:pl-8"
                >
                  {dateFormat.format(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-lg border border-dashed border-[color:var(--color-border-strong)] bg-[color:var(--color-surface)] p-4 text-sm text-[color:var(--color-fg-muted)]">
          No posts yet. Add a Markdown file to{" "}
          <code class="rounded bg-[color:var(--color-surface-2)] px-1.5 py-0.5 text-[color:var(--color-fg)]">
            src/content/blog/
          </code>
          .
        </p>
      )
    }
  </section>
</BaseLayout>
